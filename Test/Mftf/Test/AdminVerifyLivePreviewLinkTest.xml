<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminVerifyLivePreviewLinkTest">
        <annotations>
            <title value="Check for link features"/>
            <stories value="Live preview"/>
            <description value="Checking for qr code, link element, copy button and anchor."/>
            <severity value="MAJOR"/>
            <group value="service-worker-mock-service"/>
        </annotations>
        <before>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
            <helper class="\Boundsoff\PageBuilderLivePreview\Test\Mftf\Helper\RequireJsMockHelper" method="appendMixin"
                    stepKey="registerLivePreviewMock">
                <argument name="component">Boundsoff_PageBuilderLivePreview/js/viewport/live-preview</argument>
                <argument name="mixin">Boundsoff_PageBuilderLivePreview/js/viewport/live-preview-mock</argument>
            </helper>
            <pause stepKey="pauseDevelop"/>
        </before>
    </test>
</tests>
