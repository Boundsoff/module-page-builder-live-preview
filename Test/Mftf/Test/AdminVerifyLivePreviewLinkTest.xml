<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminVerifyLivePreviewLinkTest">
        <annotations>
            <title value="Check for link features"/>
            <stories value="Live preview"/>
            <description value="Checking for qr code, link element, copy button and anchor."/>
            <severity value="MAJOR"/>
            <group value="csp-disable"/>
        </annotations>
        <before>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
            <actionGroup ref="AdminCreateStoreViewActionGroup" stepKey="createStoreViewCustom"/>
            <actionGroup ref="MockServiceActionGroup" stepKey="settingUpMockService"/>
            <!-- Enter CMS -->
            <actionGroup ref="navigateToAPageWithPageBuilder" stepKey="navigateToAPageWithPageBuilder"/>
            <actionGroup ref="switchToPageBuilderStage" stepKey="switchToPageBuilderStage"/>
        </before>
        <after>
            <helper class="\Boundsoff\PageBuilderLivePreview\Test\Mftf\Helper\RequireJsMockHelper"
                    method="uninstallServiceWorker"
                    stepKey="uninstallServiceWorker"/>
            <actionGroup ref="AdminDeleteStoreViewActionGroup" stepKey="deleteStoreView"/>
        </after>
        <pause stepKey="pauseDevelop"/>
        <!-- Display details information -->
        <actionGroup ref="DialogLivePreviewActionGroup" stepKey="verifyLivePreviewButton"
                     before="clickForDetailsInformation"/>
        <clickWithLeftButton
            selector="{{PageBuilderLivePreviewDialogStoresSection.storeNodeByCode(customStore.name)}}"
            stepKey="clickForDetailsInformation"/>
        <pause stepKey="pauseDevelopFinish"/>
    </test>
</tests>
