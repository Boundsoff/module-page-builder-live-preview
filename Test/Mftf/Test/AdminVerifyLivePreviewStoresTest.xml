<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminVerifyLivePreviewStoresTest">
        <annotations>
            <title value="Generates stores"/>
            <stories value="Live preview"/>
            <description value="Generates store for pagebuilder dialog."/>
            <features value="PageBuilder"/>
            <stories value="Live preview"/>
            <severity value="MAJOR"/>
            <group value="boudnsoff"/>
            <group value="boudnsoff-live-preview"/>
            <group value="pagebuilder"/>
            <group value="pr_exclude"/>
            <group value="cloud"/>
        </annotations>
        <before>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
            <!-- Create first and second website -->
            <actionGroup ref="AdminCreateWebsiteActionGroup" stepKey="createWebsiteCustom">
                <argument name="newWebsiteName" value="{{customWebsite.name}}"/>
                <argument name="websiteCode" value="{{customWebsite.code}}"/>
            </actionGroup>
            <actionGroup ref="AdminCreateWebsiteActionGroup" stepKey="createWebsiteCustomSecond">
                <argument name="newWebsiteName" value="{{secondCustomWebsite.name}}"/>
                <argument name="websiteCode" value="{{secondCustomWebsite.code}}"/>
            </actionGroup>
            <!-- Create first and second group -->
            <actionGroup ref="AdminCreateNewStoreGroupActionGroup" stepKey="createStoreCustom">
                <argument name="website" value="{{customWebsite.name}}"/>
                <argument name="storeGroupName" value="{{customStoreGroup.name}}"/>
                <argument name="storeGroupCode" value="{{customStoreGroup.code}}"/>
            </actionGroup>
            <actionGroup ref="AdminCreateNewStoreGroupActionGroup" stepKey="createStoreCustomSecond">
                <argument name="website" value="{{secondCustomWebsite.name}}"/>
                <argument name="storeGroupName" value="{{SecondStoreGroup.name}}"/>
                <argument name="storeGroupCode" value="{{SecondStoreGroup.code}}"/>
            </actionGroup>
            <!-- Create first and second store -->
            <actionGroup ref="AdminCreateStoreViewActionGroup" stepKey="createStoreViewCustom">
                <argument name="StoreGroup" value="customStoreGroup"/>
                <argument name="customStore" value="customStore"/>
            </actionGroup>
            <actionGroup ref="AdminCreateStoreViewActionGroup" stepKey="createStoreViewCustomSecond">
                <argument name="StoreGroup" value="SecondStoreGroup"/>
                <argument name="customStore" value="SecondStoreUnique"/>
            </actionGroup>
            <actionGroup ref="AdminCreateStoreViewDisabledActionGroup" stepKey="createStoreViewDisabled">
                <argument name="StoreGroup" value="SecondStoreGroup"/>
                <argument name="customStore" value="storeViewDataDisabled"/>
            </actionGroup>
            <actionGroup ref="CliIndexerReindexActionGroup" stepKey="reindex">
                <argument name="indices" value=""/>
            </actionGroup>
            <!-- Navigate to page builder -->
            <actionGroup ref="navigateToAPageWithPageBuilder" stepKey="navigateToAPageWithPageBuilder"/>
            <actionGroup ref="switchToPageBuilderStage" stepKey="switchToPageBuilderStage"/>
        </before>
        <after>
            <!-- Remove websites -->
            <actionGroup ref="AdminDeleteWebsiteActionGroup" stepKey="deleteWebsite">
                <argument name="websiteName" value="{{customWebsite.name}}"/>
            </actionGroup>
            <actionGroup ref="AdminDeleteWebsiteActionGroup" stepKey="deleteWebsiteCustom">
                <argument name="websiteName" value="{{secondCustomWebsite.name}}"/>
            </actionGroup>
            <actionGroup ref="AdminClearGridFiltersActionGroup" stepKey="resetSearchFilter"/>
            <actionGroup ref="CliIndexerReindexActionGroup" stepKey="reindex">
                <argument name="indices" value=""/>
            </actionGroup>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logOut" after="reindex"/>
        </after>
        <!-- Verify viewport button and dialog -->
        <actionGroup ref="DialogLivePreviewActionGroup" stepKey="verifyLivePreviewButton"/>
    </test>
</tests>
