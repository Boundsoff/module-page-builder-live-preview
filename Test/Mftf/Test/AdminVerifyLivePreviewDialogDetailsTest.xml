<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminVerifyLivePreviewDialogDetailsTest" extends="AdminVerifyLivePreviewStoresTest">
        <annotations>
            <title value="Check for store details"/>
            <stories value="Live preview"/>
            <description value="Checking live preview details information about new connection."/>
            <severity value="MAJOR"/>
            <group value="pagebuilder"/>
            <group value="pr_exclude"/>
            <group value="cloud"/>
        </annotations>
        <!-- Verify viewport button and dialog -->
        <actionGroup ref="DialogLivePreviewActionGroup" stepKey="verifyLivePreviewButton"
                     before="clickForDetailsInformation"/>
        <!-- Display details information -->
        <clickWithLeftButton
            selector="{{PageBuilderLivePreviewDialogStoresSection.storeNodeByCode(customStore.name)}}"
            stepKey="clickForDetailsInformation"/>
        <!-- Verify the elements -->
        <seeElement selector="{{PageBuilderLivePreviewDetailsSection.actionBack}}" stepKey="verifyBackElement"/>
        <seeElement selector="{{PageBuilderLivePreviewDetailsSection.titleStoreByName(customStore.name)}}"
                    stepKey="verifyStoreName"/>
        <seeElement selector="{{PageBuilderLivePreviewDetailsSection.counterStoreSession}}" stepKey="verifyCounter"/>
        <seeElement selector="{{PageBuilderLivePreviewDetailsSection.formatedLink}}" stepKey="verifyFormatedLinked"/>
        <seeElement selector="{{PageBuilderLivePreviewDetailsSection.qrImg}}" stepKey="verifyImageQR"/>
        <seeElement selector="{{PageBuilderLivePreviewDetailsSection.ctaCopy}}" stepKey="verifyActionCopy"/>
        <seeElement selector="{{PageBuilderLivePreviewDetailsSection.ctaOpen}}" stepKey="verifyActionOpen"/>
    </test>
</tests>
