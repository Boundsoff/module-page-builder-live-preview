<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminVerifyLivePreviewViewportButtonTest">
        <annotations>
            <features value="PageBuilder"/>
            <stories value="Live preview"/>
            <title value="Look for the button aside for viewport"/>
            <description value="Checks for button for live preview and it's content after click."/>
            <severity value="MAJOR"/>
            <group value="boudnsoff"/>
            <group value="boudnsoff-live-preview"/>
            <group value="pagebuilder"/>
            <group value="pr_exclude"/>
            <group value="cloud"/>
        </annotations>
        <before>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
            <!-- Navigate to page builder -->
            <actionGroup ref="navigateToAPageWithPageBuilder" stepKey="navigateToAPageWithPageBuilder"/>
            <actionGroup ref="switchToPageBuilderStage" stepKey="switchToPageBuilderStage"/>
        </before>
        <after>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logOut"/>
        </after>
        <!-- Verify viewport button and dialog -->
        <actionGroup ref="DialogLivePreviewActionGroup" stepKey="verifyLivePreviewButton"/>
    </test>
</tests>
